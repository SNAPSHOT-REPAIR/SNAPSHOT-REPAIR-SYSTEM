<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Repair Khata</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Poppins',sans-serif;
}

body{
    background:#f3f6fb;
    padding:25px;
    color:#111827;
}

.topbar{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:25px;
    gap:15px;
    flex-wrap:wrap;
}

.heading h1{
    font-size:34px;
    font-weight:700;
}

.heading p{
    color:#6b7280;
    margin-top:5px;
}

.back-btn{
    text-decoration:none;
    background:#111827;
    color:white;
    padding:12px 20px;
    border-radius:14px;
    font-size:14px;
    font-weight:500;
}

.cards{
    display:flex;
    gap:18px;
    margin-bottom:28px;
}

.cards .card{
    flex:1;
    min-width:0;
}

.card{
    background:white;
    border-radius:24px;
    padding:24px;
    box-shadow:0 10px 30px rgba(0,0,0,0.05);
}

.card h3{
    color:#6b7280;
    font-size:14px;
    margin-bottom:12px;
    font-weight:500;
}

.card h2{
    font-size:34px;
    font-weight:700;
}

.total{
    border-left:6px solid #2563eb;
}

.pending{
    border-left:6px solid #ef4444;
}

.overdue{
    border-left:6px solid #f59e0b;
}

.search-box{
    margin-bottom:20px;
}

.search-box input{
    width:100%;
    max-width:350px;
    padding:14px 16px;
    border-radius:14px;
    border:1px solid #d1d5db;
    outline:none;
    font-size:14px;
    background:white;
}

.table-box{
    background:white;
    border-radius:26px;
    overflow-x:auto;
    box-shadow:0 10px 30px rgba(0,0,0,0.05);
}

.table-box::-webkit-scrollbar{
    height:6px;
}

.table-box::-webkit-scrollbar-thumb{
    background:#cbd5e1;
    border-radius:30px;
}

.table-title{
    padding:24px;
    border-bottom:1px solid #e5e7eb;
}

.table-title h2{
    font-size:22px;
}

table{
    width:100%;
    min-width:950px;
    border-collapse:collapse;
}

th{
    background:#111827;
    color:white;
    padding:16px;
    font-size:13px;
    text-align:center;
}

td{
    padding:16px;
    border-bottom:1px solid #e5e7eb;
    font-size:13px;
    text-align:center;
}

tr:hover{
    background:#f9fafb;
}

.red-row{
    background:#fee2e2;
}

.days-badge{
    padding:7px 12px;
    border-radius:30px;
    font-size:12px;
    font-weight:600;
    display:inline-block;
}

.safe{
    background:#dcfce7;
    color:#166534;
}

.danger{
    background:#fecaca;
    color:#991b1b;
}

.amount{
    font-weight:700;
    color:#2563eb;
}

.pay-btn{
    border:none;
    background:#10b981;
    color:white;
    padding:10px 16px;
    border-radius:10px;
    cursor:pointer;
    font-size:13px;
    font-weight:600;
}

.empty{
    text-align:center;
    padding:50px;
    color:#6b7280;
    font-size:16px;
}

@media(max-width:900px){

.cards{
    display:flex;
    flex-direction:row;
    gap:10px;
}

.cards .card{
    flex:1;
    padding:14px;
}

.card h3{
    font-size:11px;
}

.card h2{
    font-size:18px;
}

}

@media(max-width:768px){

body{
    padding:16px;
}

.heading h1{
    font-size:28px;
}

.card{
    padding:20px;
}

.card h2{
    font-size:28px;
}

th,
td{
    padding:14px;
    font-size:12px;
}

}

</style>
</head>
<body>

<%
const today = new Date();
const totalAmount = jobs.reduce((total, job) => total + Number(job.estimatedPrice || 0), 0);
const overdueCount = jobs.filter(job => {
    const created = new Date(job.createdAt);
    const diffDays = Math.floor((today - created) / (1000 * 60 * 60 * 24));
    return diffDays >= 7;
}).length;
%>

<div class="topbar">

<div class="heading">
    <h1>Repair Khata</h1>
    
</div>

<a href="/admin/dashboard" class="back-btn">
    Back
</a>

</div>

<div class="cards">

<div class="card total">
    <h3>Total Pending Amount</h3>
    <h2>₹ <%= totalAmount %></h2>
</div>

<div class="card pending">
    <h3>Total Unpaid Jobs</h3>
    <h2><%= jobs.length %></h2>
</div>

<div class="card overdue">
    <h3>Overdue Jobs (7+ Days)</h3>
    <h2><%= overdueCount %></h2>
</div>

</div>

<div class="search-box">

<input
    type="text"
    id="searchInput"
    placeholder="Search customer, job number, laptop..."
>

</div>

<div class="table-box">



<table>

<thead>
<tr>
<th>Job Card</th>
<th>Customer</th>
<th>Laptop</th>
<th>Problem</th>
<th>Pending Amount</th>
<th>Pending Days</th>
<th>Mark Paid</th>
</tr>
</thead>

<tbody>

<% if(jobs.length > 0){ %>

<% jobs.forEach(function(job){

const created = new Date(job.createdAt);
const diffTime = today - created;
const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));

%>

<tr class="<%= diffDays >= 7 ? 'red-row' : '' %>">

<td>
    <strong><%= job.jobNumber %></strong>
</td>

<td>
    <%= job.customerName %>
</td>

<td>
    <%= job.brand %>
    <%= job.modelNumber %>
</td>

<td>
    <%= job.problem %>
</td>

<td class="amount">
    ₹ <%= job.estimatedPrice || 0 %>
</td>

<td>

<% if(diffDays >= 7){ %>

<span class="days-badge danger">
    <%= diffDays %> Days
</span>

<% } else { %>

<span class="days-badge safe">
    <%= diffDays %> Days
</span>

<% } %>

</td>

<td>

<form action="/admin/khata-paid/<%= job._id %>" method="POST">

<button type="submit" class="pay-btn">
    Paid
</button>

</form>

</td>

</tr>

<% }) %>

<% } else { %>

<tr>
<td colspan="7" class="empty">
    No Pending Payments Found
</td>
</tr>

<% } %>

</tbody>

</table>

</div>

<script>

const searchInput = document.getElementById('searchInput');

searchInput.addEventListener('keyup', function(){

    const value = this.value.toLowerCase();

    const rows = document.querySelectorAll('tbody tr');

    rows.forEach(row => {

        const text = row.innerText.toLowerCase();

        if(text.includes(value)){
            row.style.display = '';
        }else{
            row.style.display = 'none';
        }

    });

});

</script>

</body>
</html>
