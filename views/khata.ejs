<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Dealer Khata</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Poppins',sans-serif;
}

body{
background:#eef3f9;
padding:25px;
}

.container{
max-width:1400px;
margin:auto;
}

.topbar{
display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:25px;
flex-wrap:wrap;
gap:15px;
}

.topbar h1{
font-size:34px;
font-weight:700;
color:#111827;
}

.back-btn{
background:#111827;
color:white;
padding:12px 22px;
border-radius:12px;
text-decoration:none;
font-weight:600;
}

.summary{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:18px;
margin-bottom:25px;
}

.summary-card{
background:white;
border-radius:20px;
padding:22px;
box-shadow:0 10px 25px rgba(0,0,0,.08);
}

.summary-card h3{
font-size:14px;
color:#6b7280;
margin-bottom:10px;
}

.summary-card h2{
font-size:34px;
font-weight:700;
}

.blue{
border-left:6px solid #2563eb;
}

.red{
border-left:6px solid #ef4444;
}

.orange{
border-left:6px solid #f59e0b;
}

.search-box{
margin-bottom:25px;
}

.search-box input{

width:100%;
max-width:420px;

padding:15px;

border:none;

border-radius:15px;

background:white;

box-shadow:0 5px 20px rgba(0,0,0,.08);

font-size:15px;

outline:none;

}

.party-card{

background:white;

border-radius:22px;

padding:22px;

margin-bottom:20px;

box-shadow:0 10px 25px rgba(0,0,0,.07);

}

.party-header{

display:flex;

justify-content:space-between;

align-items:center;

cursor:pointer;

flex-wrap:wrap;

gap:15px;

}

.party-left h2{

font-size:26px;

color:#111827;

}

.party-left p{

color:#6b7280;

margin-top:4px;

}

.party-right{

text-align:right;

}

.party-right h3{

font-size:14px;

color:#6b7280;

}

.party-right h1{

font-size:32px;

color:#2563eb;

}

.arrow{

font-size:28px;

transition:.3s;

}

.jobs{

display:none;

margin-top:20px;

}

.job{

display:grid;

grid-template-columns:
120px
1fr
1fr
1fr
120px
120px;

gap:15px;

align-items:center;

padding:16px;

border-bottom:1px solid #ececec;

}

.job:last-child{

border-bottom:none;

}

.job strong{

color:#111827;

}

.amount{

font-size:18px;

font-weight:700;

color:#2563eb;

}

.pay-btn{

background:#10b981;

color:white;

border:none;

padding:10px 18px;

border-radius:10px;

cursor:pointer;

font-weight:600;

}

.pay-btn:hover{

background:#059669;

}

@media(max-width:900px){

.summary{

grid-template-columns:1fr;

}

.job{

grid-template-columns:1fr;

gap:10px;

}

.party-header{

flex-direction:column;

align-items:flex-start;

}

.party-right{

text-align:left;

}

}

</style>

</head>

<body>

<%

const today=new Date();

const totalAmount=parties.reduce((t,p)=>t+p.totalAmount,0);

const totalJobs=parties.reduce((t,p)=>t+p.jobs.length,0);

const overdue=parties.filter(p=>{

return p.jobs.some(j=>{

const d=Math.floor((today-new Date(j.createdAt))/(1000*60*60*24));

return d>=7;

});

}).length;

%>

<div class="container">

<div class="topbar">

<h1>Dealer Khata</h1>

<a href="/admin/dashboard" class="back-btn">

← Dashboard

</a>

</div>

<div class="summary">

<div class="summary-card blue">

<h3>Total Pending Amount</h3>

<h2>₹ <%= totalAmount %></h2>

</div>

<div class="summary-card red">

<h3>Total Unpaid Jobs</h3>

<h2><%= totalJobs %></h2>

</div>

<div class="summary-card orange">

<h3>Total Dealers</h3>

<h2><%= parties.length %></h2>

</div>

</div>

<div class="search-box">

<input
type="text"
id="searchInput"
placeholder="Search Dealer Name">

</div>

<% if(parties.length > 0){ %>

<% parties.forEach(function(party,index){ %>

<div class="party-card">

<div
class="party-header"
onclick="toggleJobs('jobs<%= index %>', this)"
>

<div class="party-left">

<h2>
📂 <%= party.customerName %>
</h2>

<p>

Total Jobs :
<b><%= party.jobs.length %></b>

</p>

</div>

<div class="party-right">

<h3>
Pending Amount
</h3>

<h1>

₹ <%= party.totalAmount %>

</h1>

</div>

<div class="arrow">

▼

</div>

</div>

<div
class="jobs"
id="jobs<%= index %>"
>

<%

party.jobs.forEach(function(job){

const days=Math.floor(

(today-new Date(job.createdAt))

/

(1000*60*60*24)

);

%>

<div class="job">

<div>

<strong>

<%= job.jobNumber %>

</strong>

</div>

<div>

<b>

<%= job.brand %>

</b>

<br>

<%= job.modelNumber %>

</div>

<div>

<%= job.problem %>

</div>

<div>

Pending :

<br>

<span class="amount">

₹ <%= job.estimatedPrice || 0 %>

</span>

</div>

<div>

<%

if(days>=7){

%>

<span style="
background:#ef4444;
color:white;
padding:7px 12px;
border-radius:20px;
font-size:12px;
">

<%= days %> Days

</span>

<%

}else{

%>

<span style="
background:#10b981;
color:white;
padding:7px 12px;
border-radius:20px;
font-size:12px;
">

<%= days %> Days

</span>

<%

}

%>

</div>

<div>

<form
action="/admin/khata-paid/<%= job._id %>"
method="POST"
>

<button
type="submit"
class="pay-btn"
>

Paid

</button>

</form>

</div>

</div>

<%

});

%>

</div>

</div>

<%

});

%>

<%

}else{

%>

<div
style="
background:white;
padding:60px;
text-align:center;
border-radius:20px;
font-size:20px;
font-weight:600;
"
>

No Pending Jobs Found

</div>

<%

}

%>

<script>

function toggleJobs(id, element){

    const box = document.getElementById(id);
    const arrow = element.querySelector(".arrow");

    if(box.style.display === "block"){

        box.style.display = "none";
        arrow.innerHTML = "▼";
        arrow.style.transform = "rotate(0deg)";

    }else{

        box.style.display = "block";
        arrow.innerHTML = "▲";
        arrow.style.transform = "rotate(180deg)";

    }

}

const searchInput = document.getElementById("searchInput");

searchInput.addEventListener("keyup", function(){

    const value = this.value.toLowerCase();

    const cards = document.querySelectorAll(".party-card");

    cards.forEach(card=>{

        const text = card.innerText.toLowerCase();

        if(text.includes(value)){

            card.style.display="block";

        }else{

            card.style.display="none";

        }

    });

});

</script>

</div>

</body>
</html>