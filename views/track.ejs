<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Track Repair</title>
 <link rel="icon" type="image/png" href="/home.png">

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:Arial, sans-serif;
    background:#ececec;
    color:#111;
}

.wrapper{
    max-width:900px;
    margin:0 auto;
    background:linear-gradient(135deg,#ffffff,#f5f5f5);
    min-height:100vh;
    position:relative;
    overflow:hidden;
}

.wrapper::before{
    content:"";
    position:absolute;
    top:0;
    left:0;
    width:80px;
    height:80px;
    background:#0c4fb8;
    clip-path:polygon(0 0,100% 0,0 100%);
}

.wrapper::after{
    content:"";
    position:absolute;
    right:0;
    bottom:0;
    width:100px;
    height:100px;
    background:#0c4fb8;
    clip-path:polygon(100% 0,100% 100%,0 100%);
}

.top{
    padding:28px 18px 18px;
    position:relative;
}

.back-btn{
    position:absolute;
    right:14px;
    top:14px;
    z-index:5;
}

.back-btn button{
    background:#e40000;
    color:#fff;
    border:none;
    padding:8px 14px;
    border-radius:8px;
    cursor:pointer;
    font-size:14px;
    font-weight:bold;
}

.logo-row{
    display:flex;
    align-items:center;
    gap:12px;
    margin-top:16px;
}

.real-logo{
    width:72px;
    height:auto;
    flex-shrink:0;
}

.title h1{
    font-size:34px;
    line-height:1;
    font-weight:900;
}

.title h2{
    font-size:20px;
    line-height:1.2;
    color:#e51d1d;
    font-weight:900;
    margin-top:3px;
}

.mobile-bar{
    margin-top:18px;
    background:#f2d400;
    padding:12px;
    font-size:17px;
    font-weight:900;
    line-height:1.5;
}

.contact-row{
    margin-top:18px;
}

.contact-left{
    font-size:15px;
    font-weight:bold;
    line-height:1.6;
}

.qr{
    margin-top:14px;
}

.qr img{
    width:110px;
    height:auto;
}

.job-title{
    margin-top:22px;
    background:#0c4fb8;
    color:white;
    text-align:center;
    font-size:23px;
    font-weight:900;
    padding:14px 10px;
}

.section{
    padding:20px 18px 0;
}

.section-title{
    background:#0c4fb8;
    color:white;
    display:inline-block;
    padding:9px 14px;
    font-size:18px;
    font-weight:900;
    margin-bottom:15px;
}

.row{
    display:flex;
    gap:10px;
    margin-bottom:11px;
    font-size:16px;
    line-height:1.4;
}

.row strong{
    width:125px;
    flex-shrink:0;
}

.row .value{
    flex:1;
    word-break:break-word;
}

.status{
    display:inline-block;
    background:#000;
    color:#fff;
    padding:6px 14px;
    border-radius:20px;
}

.terms{
    padding:22px 18px 35px;
}

.terms-title{
    background:#0c4fb8;
    color:white;
    display:inline-block;
    padding:10px 14px;
    font-size:18px;
    font-weight:900;
    margin-bottom:14px;
}

.terms p{
    font-size:13px;
    font-weight:bold;
    line-height:1.5;
    margin-bottom:8px;
}

@media(min-width:768px){

    .top{
        padding:40px 55px 22px;
    }

    .back-btn{
        right:28px;
        top:22px;
    }

    .back-btn button{
        font-size:15px;
        padding:10px 18px;
    }

    .logo-row{
        gap:20px;
        margin-top:0;
    }

    .real-logo{
        width:150px;
    }

    .title h1{
        font-size:72px;
    }

    .title h2{
        font-size:42px;
    }

    .mobile-bar{
        margin-top:28px;
        padding:16px 22px;
        font-size:28px;
    }

    .contact-row{
        margin-top:28px;
        display:flex;
        justify-content:space-between;
        align-items:flex-start;
        gap:20px;
    }

    .contact-left{
        font-size:22px;
        line-height:1.8;
    }

    .qr{
        margin-top:0;
    }

    .qr img{
        width:150px;
    }

    .job-title{
        margin-top:28px;
        font-size:44px;
        padding:18px;
    }

    .section{
        padding:28px 55px 0;
    }

    .section-title{
        font-size:26px;
        padding:11px 20px;
    }

    .row{
        font-size:24px;
        margin-bottom:14px;
    }

    .row strong{
        width:240px;
    }

    .terms{
        padding:28px 55px 50px;
    }

    .terms-title{
        font-size:28px;
        padding:12px 20px;
    }

    .terms p{
        font-size:18px;
        margin-bottom:10px;
    }
}
</style>
</head>
<body>

<div class="wrapper">

    <div class="top">

        <div class="back-btn">
            <button onclick="history.back()">Back</button>
        </div>

        <div class="logo-row">
            <img src="/images/logo.png" alt="Snapshot Logo" class="real-logo">

            <div class="title">
                <h1>SNAPSHOT</h1>
                <h2>SERVICE CENTRE</h2>
            </div>
        </div>

        <div class="mobile-bar">
            MOBILE NUMBER :- 7770000493 | 8149295882
        </div>

        <div class="contact-row">
            <div class="contact-left">
                MAIL ID :- SNAPSHOTCOMPUTER@GMAIL.COM <br>
                ADD :- SHOP NO. 11, NMC COMPLEX, SADAR, NAGPUR
            </div>

            <% if (typeof qrCode !== 'undefined' && qrCode) { %>
                <div class="qr">
                    <img src="<%= qrCode %>">
                </div>
            <% } %>
        </div>

        <div class="job-title">
            JOB CARD NO : <%= job.jobNumber %>
        </div>

    </div>

    <div class="section">

        <div class="section-title">CUSTOMER DETAILS</div>

        <div class="row">
            <strong>NAME :-</strong>
            <div class="value"><%= job.customerName %></div>
        </div>

        <div class="row">
            <strong>CONTACT NO :-</strong>
            <div class="value"><%= job.mobile || '' %></div>
        </div>

    </div>

    <div class="section">

        <div class="section-title">LAPTOP INFORMATION</div>

        <div class="row">
            <strong>ASSIGNEE :-</strong>
            <div class="value"><%= job.assignee || '' %></div>
        </div>

        <div class="row">
            <strong>PRODUCT :-</strong>
            <div class="value">LAPTOP</div>
        </div>

        <div class="row">
            <strong>BRAND :-</strong>
            <div class="value"><%= job.brand %></div>
        </div>

        <div class="row">
            <strong>SERIAL NO :-</strong>
            <div class="value"><%= job.serialNumber %></div>
        </div>

        <div class="row">
            <strong>MODEL NO :-</strong>
            <div class="value"><%= job.modelNumber %></div>
        </div>

        <div class="row">
            <strong>PROBLEM :-</strong>
            <div class="value"><%= job.problem %></div>
        </div>

        <div class="row">
            <strong>STATUS :-</strong>
            <div class="value">
                <span class="status"><%= job.status %></span>
            </div>
        </div>

        <div class="row">
            <strong>DATE :-</strong>
            <div class="value"><%= new Date().toLocaleDateString() %></div>
        </div>
        
        <div class="row">
            <strong>Accessories Received :-</strong>
            <div class="value"><%= job.accessories %></div>
        </div>

        <div class="row">
    <strong>ESTIMATE :-</strong>
    ₹ <%= job.estimatedPrice || '0' %>
</div>
    </div>

    <div class="terms">

        <div class="terms-title">REPAIR TERMS & CONDITIONS</div>

        <p>1) PLEASE COLLECT YOUR PRODUCT WITHIN 7 DAYS AFTER REPAIR COMPLETION.</p>
        <p>2) SERVICE/REPAIR CHARGES MUST BE PAID AT THE TIME OF PRODUCT DELIVERY.</p>
        <p>3) IF ANY EXTRA PART OR REPAIR WORK IS NEEDED, IT WILL BE DONE ONLY AFTER CUSTOMER APPROVAL.</p>
        <p>4) IF THE PRODUCT IS NOT COLLECTED WITHIN 15 DAYS, THE SHOP WILL NOT BE RESPONSIBLE.</p>

    </div>

</div>


</body>
</html>