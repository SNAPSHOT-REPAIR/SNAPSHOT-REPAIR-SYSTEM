<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Live Jobs - Engineer Dashboard</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>

        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
            font-family:'Poppins', sans-serif;
        }

        body{
            background:#f0fdf4;
            display:flex;
        }

        .sidebar{
            width:260px;
            height:100vh;
            background:#064e3b;
            color:white;
            position:fixed;
            left:0;
            top:0;
            padding:25px;
        }

        .topbar{
            display:flex;
            flex-direction:column;
            align-items:flex-start;
            margin-bottom:22px;
            padding-top:8px;
        }

        .logo-box{
            display:flex;
            align-items:center;
            gap:12px;
        }

        .main{
            margin-left:260px;
            width:calc(100% - 260px);
            padding:30px;
        }

        .page-title{
            font-size:28px;
            font-weight:700;
            color:#064e3b;
            margin-bottom:22px;
        }

        .menu-buttons{
            display:flex;
            flex-direction:column;
            gap:10px;
            margin-top:18px;
        }

        .menu-btn{
            display:block;
            text-decoration:none;
            background:#10b981;
            color:white;
            padding:12px 16px;
            border-radius:12px;
            text-align:center;
            font-weight:600;
            transition:0.3s;
        }

        .menu-btn:hover{
            background:#059669;
        }

        .dashboard-btn{
            display:block;
            text-decoration:none;
            background:#065f46;
            color:white;
            padding:12px 16px;
            border-radius:12px;
            text-align:center;
            font-weight:600;
            transition:0.3s;
        }

        .dashboard-btn:hover{
            background:#047857;
        }

        .logout-btn{
            display:block;
            text-decoration:none;
            background:#ef4444;
            color:white;
            padding:12px 16px;
            border-radius:12px;
            text-align:center;
            font-weight:600;
            transition:0.3s;
        }

        .logout-btn:hover{
            background:#dc2626;
        }

        .cards{
            display:flex;
            gap:12px;
            overflow-x:auto;
            padding-bottom:5px;
        }

        .card{
            min-width:160px;
            flex:1;
            border-radius:24px;
            padding:18px 14px;
            background:white;
            text-align:center;
            box-shadow:0 4px 14px rgba(0,0,0,0.06);
        }

        .card h3{
            font-size:13px;
            color:#6b7280;
            margin-bottom:10px;
        }

        .card h2{
            font-size:32px;
            font-weight:700;
            color:#064e3b;
        }

        .cards::-webkit-scrollbar{
            display:none;
        }

        .search-box{
            display:flex;
            justify-content:flex-end;
            margin:20px 0;
        }

        .search-box input{
            width:260px;
            padding:11px 14px;
            border:1px solid #d1d5db;
            border-radius:10px;
            outline:none;
            font-size:14px;
        }

        .table-container{
            background:white;
            padding:25px;
            border-radius:20px;
            box-shadow:0 5px 20px rgba(0,0,0,0.05);
            overflow-x:auto;
            -webkit-overflow-scrolling:touch;
        }

        table{
            width:100%;
            min-width:1400px;
            border-collapse:collapse;
        }

        th:nth-child(6),
        td:nth-child(6){
            min-width:300px;
            white-space:normal;
        }

        table th{
            background:#064e3b;
            color:white;
            padding:16px;
            text-align:left;
            font-size:14px;
        }

        table td{
            padding:16px;
            border-bottom:1px solid #e5e7eb;
            font-size:14px;
            color:#374151;
        }

        tr:hover{
            background:#f9fafb;
        }

        .status{
            padding:6px 14px;
            border-radius:30px;
            color:white;
            font-size:12px;
            font-weight:600;
            white-space:nowrap;
        }

        .pending{
            background:#f59e0b;
        }

        .progress{
            background:#3b82f6;
        }

        select{
            padding:10px;
            border-radius:10px;
            border:1px solid #d1d5db;
            outline:none;
        }

        .update-btn{
            background:#10b981;
            color:white;
            border:none;
            padding:10px 16px;
            border-radius:10px;
            cursor:pointer;
            margin-left:8px;
            font-weight:600;
        }

        .update-btn:hover{
            background:#059669;
        }

        .empty{
            text-align:center;
            padding:40px;
            color:#6b7280;
            font-size:16px;
        }

        @media(max-width:900px){

            body{
                flex-direction:column;
            }

            .sidebar{
                width:100%;
                height:auto;
                position:relative;
            }

            .main{
                margin-left:0;
                width:100%;
                padding:16px;
            }

            .table-container{
                padding:12px;
                overflow-x:auto;
            }

            table{
                min-width:1400px;
            }

            table th,
            table td{
                padding:10px;
                font-size:13px;
                white-space:nowrap;
            }

            select{
                padding:7px;
                font-size:12px;
            }

            .update-btn{
                padding:7px 10px;
                font-size:12px;
                margin-left:5px;
            }

            .status{
                font-size:11px;
                padding:5px 10px;
            }

            .search-box{
                justify-content:stretch;
            }

            .search-box input{
                width:100%;
            }

            .card{
                min-width:150px;
            }
        }

    </style>
</head>

<body>

    <!-- SIDEBAR -->

    <div class="sidebar">

        <div class="topbar">

            <div class="logo-box">

                <img
                    src="/logo.png"
                    style="width:65px;height:65px;object-fit:contain;"
                >

                <div>

                    <div style="
                        font-size:28px;
                        font-weight:700;
                        color:white;
                        line-height:1;
                    ">
                        SNAPSHOT
                    </div>

                    <div style="
                        font-size:18px;
                        font-weight:600;
                        color:#6ee7b7;
                        line-height:1.2;
                    ">
                        SERVICE CENTER
                    </div>

                </div>

            </div>

            <h1 style="
                font-size:18px;
                font-weight:600;
                color:white;
                margin-top:15px;
                text-align:center;
                width:100%;
            ">
                Engineer Live Jobs
            </h1>

        </div>


        <div class="menu-buttons">

            <a href="/engineer/dashboard" class="dashboard-btn">
                Dashboard
            </a>

            <a href="/engineer/live-jobs" class="menu-btn">
                Live Jobs
            </a>

            <a href="/engineer/logout" class="logout-btn">
                Logout
            </a>

        </div>

    </div>


    <!-- MAIN -->

    <div class="main">

        <h1 class="page-title">
            Live Jobs
        </h1>


        <!-- CARDS -->

        <div class="cards">

            <div class="card">

                <h3>Live Jobs</h3>

                <h2>
                    <%= jobs.length %>
                </h2>

            </div>


            <div class="card">

                <h3>Pending Jobs</h3>

                <h2>
                    <%= jobs.filter(job => job.status === 'Pending').length %>
                </h2>

            </div>


            <div class="card">

                <h3>In Progress Jobs</h3>

                <h2>
                    <%= jobs.filter(job => job.status === 'In Progress').length %>
                </h2>

            </div>

        </div>


        <!-- SEARCH -->

        <div class="search-box">

            <input
                type="text"
                id="searchInput"
                placeholder="Search Job / Brand / Model"
            >

        </div>


        <!-- TABLE -->

        <div class="table-container">

            <table>

                <thead>

                    <tr>

                        <th>Job Card</th>
                        <th>Date</th>
                        <th>Brand</th>
                        <th>Model</th>
                        <th>Serial Number</th>
                        <th>Problem</th>
                        <th>Current Status</th>
                        <th>Repair Eng</th>
                        <th>Update Status</th>
                        <th>Remark</th>

                    </tr>

                </thead>


                <tbody>

                    <% if(jobs.length > 0){ %>

                        <% jobs.forEach(job => { %>

                            <tr>

                                <td>
                                    <%= job.jobNumber %>
                                </td>


                                <td>
                                    <%= job.jobDate ? new Date(job.jobDate).toLocaleDateString('en-GB') : '' %>
                                </td>


                                <td>
                                    <%= job.brand %>
                                </td>


                                <td>
                                    <%= job.modelNumber %>
                                </td>


                                <td>
                                    <%= job.serialNumber %>
                                </td>


                                <td>
                                    <%= job.problem %>
                                </td>


                                <!-- CURRENT STATUS -->

                                <td>

                                    <% if(job.status === 'Pending'){ %>

                                        <span class="status pending">
                                            Pending
                                        </span>

                                    <% } else { %>

                                        <span class="status progress">
                                            In Progress
                                        </span>

                                    <% } %>

                                </td>


                                <!-- ENGINEER -->

                                <td>
                                    <%= job.repairEngineer || 'None' %>
                                </td>


                                <!-- UPDATE STATUS -->

                                <td>

                                    <form
                                        action="/engineer/update-status/<%= job._id %>"
                                        method="POST"
                                    >

                                        <select name="status">

                                            <option
                                                value="Pending"
                                                <%= job.status === 'Pending' ? 'selected' : '' %>
                                            >
                                                Pending
                                            </option>

                                            <option
                                                value="In Progress"
                                                <%= job.status === 'In Progress' ? 'selected' : '' %>
                                            >
                                                In Progress
                                            </option>

                                            <option
                                                value="Completed"
                                            >
                                                Completed
                                            </option>

                                            <option
                                                value="Return"
                                            >
                                                Return
                                            </option>

                                        </select>

                                        <button
                                            type="submit"
                                            class="update-btn"
                                        >
                                            Update
                                        </button>

                                    </form>

                                </td>


                                <!-- REMARK -->

                                <td>

                                    <form
                                        action="/engineer/update-remark/<%= job._id %>"
                                        method="POST"
                                    >

                                        <input
                                            type="text"
                                            name="remark"
                                            value="<%= job.remark || '' %>"
                                            placeholder="Repair Work"
                                            style="
                                                width:140px;
                                                padding:6px;
                                                border:1px solid #ccc;
                                                border-radius:6px;
                                            "
                                        >

                                        <button
                                            type="submit"
                                            class="update-btn"
                                        >
                                            Save
                                        </button>

                                    </form>

                                </td>

                            </tr>

                        <% }) %>

                    <% } else { %>

                        <tr>

                            <td colspan="10" class="empty">
                                No Live Jobs Found
                            </td>

                        </tr>

                    <% } %>

                </tbody>

            </table>

        </div>

    </div>


    <!-- SEARCH SCRIPT -->

    <script>

        const searchInput = document.getElementById("searchInput");

        searchInput.addEventListener("keyup", function(){

            const value = this.value.toLowerCase();

            const rows = document.querySelectorAll("tbody tr");

            rows.forEach(row => {

                const text = row.innerText.toLowerCase();

                if(text.includes(value)){

                    row.style.display = "";

                }else{

                    row.style.display = "none";

                }

            });

        });

    </script>

</body>
</html>